<view class="page data-v-f1ab5fee"><view class="search-bar data-v-f1ab5fee"><view class="search-input-wrap data-v-f1ab5fee"><text class="search-icon data-v-f1ab5fee">🔍</text><input class="search-input data-v-f1ab5fee" placeholder="搜索场馆名称" confirm-type="search" bindconfirm="{{a}}" value="{{b}}" bindinput="{{c}}"/></view></view><view wx:if="{{d}}" class="status data-v-f1ab5fee"><text class="status-text data-v-f1ab5fee">加载中…</text></view><view wx:elif="{{e}}" class="status data-v-f1ab5fee"><text class="status-text error data-v-f1ab5fee">{{f}}</text><button class="retry-btn data-v-f1ab5fee" size="mini" bindtap="{{g}}">重试</button></view><view wx:elif="{{h}}" class="status data-v-f1ab5fee"><text class="status-text data-v-f1ab5fee">暂无场馆</text><text wx:if="{{i}}" class="status-sub data-v-f1ab5fee">未搜索到"{{j}}"</text></view><scroll-view wx:else class="list data-v-f1ab5fee" scroll-y refresher-enabled refresher-triggered="{{l}}" bindrefresherrefresh="{{m}}"><view wx:for="{{k}}" wx:for-item="item" wx:key="c" class="card data-v-f1ab5fee" bindtap="{{item.d}}"><view class="card-body data-v-f1ab5fee"><text class="card-name data-v-f1ab5fee">{{item.a}}</text><text class="card-id data-v-f1ab5fee">ID: {{item.b}}</text></view><text class="card-arrow data-v-f1ab5fee">›</text></view></scroll-view></view>