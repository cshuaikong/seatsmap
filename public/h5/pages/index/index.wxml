<view class="page"><view class="header"><view class="header-main"><scroll-view wx:if="{{a}}" class="price-legend" scroll-x enable-flex><view wx:for="{{b}}" wx:for-item="c" wx:key="c" class="price-item" bindtap="{{c.d}}"><text class="price-dot" style="{{'background-color:' + c.a}}"></text><text class="price-text">{{c.b}}</text></view></scroll-view></view></view><view class="map-wrap"><block wx:if="{{r0}}"><canvas type="2d" id="seatmap-canvas" class="map" bindtouchstart="{{c}}" bindtouchmove="{{d}}" bindtouchend="{{e}}" bindtouchcancel="{{f}}"></canvas></block><block wx:if="{{r0}}"><canvas type="2d" id="seatmap-minimap" class="minimap" bindtouchstart="{{g}}"></canvas></block></view><view wx:if="{{h}}" class="loading">座位图加载中…</view><view wx:elif="{{i}}" class="error">{{j}}</view><view class="bar" catchtouchstart="{{p}}"><scroll-view scroll-x class="sel-scroll" enhanced show-scrollbar="{{false}}"><block wx:if="{{k}}"><view wx:for="{{l}}" wx:for-item="item" wx:key="c" class="sel-chip"><text class="chip-label">{{item.a}}</text><view class="chip-x" catchtap="{{item.b}}">×</view></view></block><text wx:else class="sel-empty">点击座位进行选择</text></scroll-view><view class="bar-row"><text class="total">合计 <text class="total-num">¥{{m}}</text></text><button size="mini" type="primary" disabled="{{n}}" bindtap="{{o}}">确认选座</button></view></view></view>